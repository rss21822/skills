{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-ai-development-os/w0-runtime-postexecution-attestation.schema.json",
  "title": "W0 Validator Runtime Postexecution Attestation",
  "description": "Operator-external authority attestation/signature are absent before VALIDATE and created only after validator exit. Signed raw bytes use required-list order, minified UTF-8, no BOM/newline/duplicates/extra whitespace. It proves actual process/input closure, invocation, project write zero, post PASS, and that source/project/temp lock and temp remain active for the subsequent external human chain, expected-only admission, ADMIT semantic validation, signed execution/worker-ready receipt, bootstrap PASS, and first-effect capability consumption. Same run/session/nonce/challenge/config/package/project/temp/evidence-root identities, loaded closure, exact read set, enforcement, and exit 0 are mandatory; cleanup or lock release here is invalid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "kind", "id", "runId", "receiverNonce", "authoritySessionId",
    "prelaunchAssertionSha256", "resolvedPrepareExecutionAttestationPath", "prepareExecutionAttestationSha256", "prepareExecutionAttestationFileIdentity", "prepareAuthoritySessionId", "prepareMonitorSessionId",
    "resolvedLaunchChallengePath", "launchChallengeSha256", "challengeFileIdentity", "resolvedAuthorizationEvidenceRoot", "authorizationEvidenceRootIdentity", "operatorExpectedConfigSha256", "configSha256", "packageSha256", "resolvedProjectRoot", "projectRootIdentity",
    "resolvedConfigPath", "configFileIdentity", "resolvedPackagePath", "packageFileIdentity",
    "resolvedTempRoot", "tempRootIdentity", "projectInputTreeSha256", "tempCopySetSha256", "readInputSetSha256", "readInputIdentitySetSha256",
    "expectedArgvSha256", "expectedCwdSha256", "expectedEnvSha256",
    "coverage", "loadedClosureSha256", "argvSha256", "cwdSha256", "envSha256",
    "loadedClosureMatchesConfig", "readInputClosureMatches", "argvMatches", "cwdMatches", "envClosed", "readOnly", "noWriteSwapAddMaintained",
    "projectPackageSkillWriteCount", "authorizationEvidenceWriteCountAtPost", "continuousLockRetainedForAdmit", "tempRetainedForAdmit", "admitPhaseReady",
    "startedAt", "completedAt", "attestedAt", "exitCode"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "w0-runtime-postexecution-v1" },
    "id": { "type": "string", "pattern": "^W0-RUNTIME-POST-[A-Z0-9][A-Z0-9._-]*$" },
    "runId": { "type": "string", "minLength": 16 },
    "receiverNonce": { "type": "string", "minLength": 32 },
    "authoritySessionId": { "type": "string", "minLength": 16 },
    "prelaunchAssertionSha256": { "$ref": "#/$defs/sha256" },
    "resolvedPrepareExecutionAttestationPath": { "$ref": "#/$defs/absolutePath" },
    "prepareExecutionAttestationSha256": { "$ref": "#/$defs/sha256" },
    "prepareExecutionAttestationFileIdentity": { "type": "string", "minLength": 1 },
    "prepareAuthoritySessionId": { "type": "string", "minLength": 16 },
    "prepareMonitorSessionId": { "type": "string", "minLength": 16 },
    "resolvedLaunchChallengePath": { "$ref": "#/$defs/absolutePath" },
    "launchChallengeSha256": { "$ref": "#/$defs/sha256" },
    "challengeFileIdentity": { "type": "string", "minLength": 1 },
    "resolvedAuthorizationEvidenceRoot": { "$ref": "#/$defs/absolutePath" },
    "authorizationEvidenceRootIdentity": { "type": "string", "minLength": 1 },
    "operatorExpectedConfigSha256": { "$ref": "#/$defs/sha256", "description": "Signed out-of-band expected config hash, unchanged from PREPARE/prelaunch and equal to actual configSha256." },
    "configSha256": { "$ref": "#/$defs/sha256", "description": "Post-run recomputed raw config hash, equal to operatorExpectedConfigSha256." },
    "packageSha256": { "$ref": "#/$defs/sha256" },
    "resolvedProjectRoot": { "$ref": "#/$defs/absolutePath" },
    "projectRootIdentity": { "type": "string", "minLength": 1 },
    "resolvedConfigPath": { "$ref": "#/$defs/absolutePath" },
    "configFileIdentity": { "type": "string", "minLength": 1 },
    "resolvedPackagePath": { "$ref": "#/$defs/absolutePath" },
    "packageFileIdentity": { "type": "string", "minLength": 1 },
    "resolvedTempRoot": { "$ref": "#/$defs/absolutePath" },
    "tempRootIdentity": { "type": "string", "minLength": 1 },
    "projectInputTreeSha256": { "$ref": "#/$defs/sha256" },
    "tempCopySetSha256": { "$ref": "#/$defs/sha256" },
    "readInputSetSha256": { "$ref": "#/$defs/sha256" },
    "readInputIdentitySetSha256": { "$ref": "#/$defs/sha256" },
    "expectedArgvSha256": { "$ref": "#/$defs/sha256" },
    "expectedCwdSha256": { "$ref": "#/$defs/sha256" },
    "expectedEnvSha256": { "$ref": "#/$defs/sha256" },
    "coverage": { "const": "actual-loaded-process-and-read-input-identity-closure" },
    "loadedClosureSha256": {
      "$ref": "#/$defs/sha256",
      "description": "Canonical digest of the authority-observed loaded process image, module, library, executable file/volume identity, and child-process closure."
    },
    "argvSha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 of the bootstrap-derived canonical pinned-Python validator argv vector: every path is identity-resolved to uppercase-drive forward-slash form, UTF-8 elements are joined by one NUL, and there is no trailing NUL. Raw host spelling is not part of this Python invocation digest." },
    "cwdSha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 of the receiver-normalized absolute cwd UTF-8 bytes." },
    "envSha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 of ordinal-name-sorted UTF-8 NAME=VALUE entries joined by one NUL, with no trailing NUL." },
    "loadedClosureMatchesConfig": { "const": true },
    "readInputClosureMatches": { "const": true },
    "argvMatches": { "const": true },
    "cwdMatches": { "const": true },
    "envClosed": { "const": true },
    "readOnly": { "const": true },
    "noWriteSwapAddMaintained": { "const": true },
    "projectPackageSkillWriteCount": { "const": 0 },
    "authorizationEvidenceWriteCountAtPost": { "const": 0 },
    "continuousLockRetainedForAdmit": { "const": true },
    "tempRetainedForAdmit": { "const": true },
    "admitPhaseReady": { "const": true },
    "startedAt": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,7})?(?:Z|[+-](?:(?:0\\d|1[0-3]):[0-5]\\d|14:00))$" },
    "completedAt": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,7})?(?:Z|[+-](?:(?:0\\d|1[0-3]):[0-5]\\d|14:00))$" },
    "attestedAt": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,7})?(?:Z|[+-](?:(?:0\\d|1[0-3]):[0-5]\\d|14:00))$" },
    "exitCode": { "const": 0 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "absolutePath": { "type": "string", "pattern": "^[A-Za-z]:[\\\\/].+", "description": "Windows local-drive absolute path for W0 lifecycle v1. POSIX, UNC, device, ADS, and relative paths are invalid." }
  }
}
