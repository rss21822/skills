{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work Package",
  "type": "object",
  "required": [
    "id",
    "title",
    "objective",
    "requirements",
    "read",
    "create",
    "modify",
    "do_not_touch",
    "tests",
    "rollback",
    "done"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^WP-[A-Z0-9]+-[0-9]{3}$"
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "read": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "create": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modify": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "do_not_touch": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "string"
    },
    "done": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
