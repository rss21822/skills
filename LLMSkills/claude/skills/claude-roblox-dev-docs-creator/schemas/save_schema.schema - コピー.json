{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-ai-development-os/save-schema.schema.json",
  "title": "Save Data Schema Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "project", "prefix", "dataVersion", "root", "migrations",
    "sessionLocking", "corruptionRecovery", "status"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "project": { "type": "string", "minLength": 1 },
    "prefix": { "type": "string", "pattern": "^[A-Z0-9]{2,6}$" },
    "dataVersion": { "type": "integer", "minimum": 1 },
    "root": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "default", "validation", "owner"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "default": true,
          "validation": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "procedure", "tests", "rollback"],
        "properties": {
          "from": { "type": "integer", "minimum": 1 },
          "to": { "type": "integer", "minimum": 1 },
          "procedure": { "type": "string", "minLength": 1 },
          "tests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "rollback": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sessionLocking": { "type": "string", "minLength": 1 },
    "corruptionRecovery": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "approved", "superseded"] }
  }
}
