{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-ai-development-os/docs-manifest.schema.json",
  "title": "Roblox Documentation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "prefix",
    "generatedAt",
    "baselineId",
    "documents"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "project": { "type": "string", "minLength": 1 },
    "prefix": { "type": "string", "pattern": "^[A-Z0-9]{2,6}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "baselineId": { "type": ["string", "null"], "minLength": 1 },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "version",
          "domain",
          "required",
          "status",
          "phase",
          "trigger"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
          },
          "domain": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "status": { "enum": ["draft", "review", "approved", "superseded"] },
          "phase": { "type": "string", "minLength": 1 },
          "trigger": { "type": ["string", "null"] }
        }
      }
    }
  }
}
