{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-ai-development-os/analytics-event.schema.json",
  "title": "Analytics Event Dictionary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "prefix", "events"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "project": { "type": "string", "minLength": 1 },
    "prefix": { "type": "string", "pattern": "^[A-Z0-9]{2,6}$" },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "source", "trigger", "fields", "sampling",
        "expectedVolumePerDau", "kpis", "privacyNotes", "test", "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^AN-[A-Z0-9]+-[0-9]{3}$" },
        "name": { "type": "string", "minLength": 1 },
        "source": { "enum": ["server", "client", "external"] },
        "trigger": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "required", "privacyClass"],
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "privacyClass": { "enum": ["none", "pseudonymous", "sensitive"] }
            }
          }
        },
        "sampling": { "type": "number", "minimum": 0, "maximum": 1 },
        "expectedVolumePerDau": { "type": "number", "minimum": 0 },
        "kpis": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "privacyNotes": { "type": "string" },
        "test": { "type": "string", "minLength": 1 },
        "status": { "enum": ["proposed", "approved", "superseded"] }
      }
    }
  }
}
