{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-ai-development-os/post-sync-manifest.schema.json",
  "title": "D5 Post-Sync Hash Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transactionId", "baselineId", "generatedAt", "selfIncluded", "files"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "transactionId": { "type": "string", "minLength": 1 },
    "baselineId": { "type": "string", "pattern": "^B2-[A-Z0-9][A-Z0-9._-]*$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "selfIncluded": { "const": false },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "Entries are sorted ascending by project-relative POSIX path; duplicate paths are invalid.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
