{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-ai-development-os/remote-contract.schema.json",
  "title": "Remote Contract Dictionary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "prefix", "contracts"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "project": { "type": "string", "minLength": 1 },
    "prefix": { "type": "string", "pattern": "^[A-Z0-9]{2,6}$" },
    "contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/contract" }
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "direction", "transport", "payload", "validation",
        "rateLimit", "idempotency", "serverResult", "logging", "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^NET-[A-Z0-9]+-[0-9]{3}$" },
        "name": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["client_to_server", "server_to_client", "bidirectional"] },
        "transport": { "enum": ["RemoteEvent", "RemoteFunction", "UnreliableRemoteEvent"] },
        "payload": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "required"],
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "constraints": { "type": "string" }
            }
          }
        },
        "validation": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capacity", "refillPerSecond", "scope"],
          "properties": {
            "capacity": { "type": "integer", "minimum": 1 },
            "refillPerSecond": { "type": "number", "exclusiveMinimum": 0 },
            "scope": { "enum": ["player", "server", "session"] }
          }
        },
        "idempotency": { "type": "string", "minLength": 1 },
        "serverResult": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "logging": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "status": { "enum": ["proposed", "approved", "superseded"] }
      }
    }
  }
}
