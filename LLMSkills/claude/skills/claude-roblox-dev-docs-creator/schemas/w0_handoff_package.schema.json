{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-ai-development-os/w0-handoff-package.schema.json",
  "title": "W0 Implementation Handoff Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "packageId", "project", "prefix", "createdAt",
    "d5Approval", "p0", "baselines", "postSyncManifest",
    "firstAuthorizedWp", "postP0D4Records"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "packageId": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "prefix": { "type": "string", "pattern": "^[A-Z0-9]{2,6}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "d5Approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "approvedAt", "approver", "recordPath", "recordSha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "approver": { "type": "string", "minLength": 1 },
        "recordPath": { "type": "string", "minLength": 1 },
        "recordSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "p0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startApprovalId", "startApprovalRecordPath", "startApprovalRecordSha256",
        "contractApprovalId", "contractApprovalRecordPath", "contractApprovalRecordSha256"
      ],
      "properties": {
        "startApprovalId": { "type": "string", "minLength": 1 },
        "startApprovalRecordPath": { "type": "string", "minLength": 1 },
        "startApprovalRecordSha256": { "$ref": "#/$defs/sha256" },
        "contractApprovalId": { "type": "string", "minLength": 1 },
        "contractApprovalRecordPath": { "type": "string", "minLength": 1 },
        "contractApprovalRecordSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "baselines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["b0", "b1", "b2"],
      "properties": {
        "b0": { "$ref": "#/$defs/b0Reference" },
        "b1": { "$ref": "#/$defs/b1Reference" },
        "b2": { "$ref": "#/$defs/b2Reference" }
      }
    },
    "postSyncManifest": {
      "allOf": [
        { "$ref": "#/$defs/artifactReference" },
        { "description": "Independent post-sync manifest containing path, bytes, and SHA-256 for every synchronized artifact." }
      ]
    },
    "firstAuthorizedWp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "postP0D4Records": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/auditRecord" },
      "allOf": [
        {
          "contains": { "properties": { "auditTrack": { "const": "consistency" } } },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "properties": { "auditTrack": { "const": "roblox-readiness" } } },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "properties": { "auditTrack": { "const": "clean-room" } } },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "baselineReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "fileSetSha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "fileSetSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "b0Reference": {
      "allOf": [
        { "$ref": "#/$defs/baselineReference" },
        { "properties": { "id": { "pattern": "^B0-[A-Z0-9][A-Z0-9._-]*$" } } }
      ]
    },
    "b1Reference": {
      "allOf": [
        { "$ref": "#/$defs/baselineReference" },
        { "properties": { "id": { "pattern": "^B1-[A-Z0-9][A-Z0-9._-]*$" } } }
      ]
    },
    "b2Reference": {
      "allOf": [
        { "$ref": "#/$defs/baselineReference" },
        { "properties": { "id": { "pattern": "^B2-[A-Z0-9][A-Z0-9._-]*$" } } }
      ]
    },
    "auditRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "auditTrack", "path", "sha256", "candidateBaseline",
        "criticalCount", "majorCount", "verdict"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "auditTrack": { "enum": ["consistency", "roblox-readiness", "clean-room"] },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "candidateBaseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "path", "sha256", "fileSetSha256"],
          "properties": {
            "id": { "type": "string", "pattern": "^P0-CAND-[A-Z0-9][A-Z0-9._-]*$" },
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "fileSetSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "criticalCount": { "const": 0 },
        "majorCount": { "const": 0 },
        "verdict": { "const": "pass" }
      }
    }
  }
}
