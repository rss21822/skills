{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-ai-development-os/d4-audit-request.schema.json",
  "title": "D4 Lane Audit Request",
  "description": "Cycle-free request wrapper. First freeze requestCore and hash its canonical JSON. Then compile the exact submitted provider payload from installed policy components plus requestCore, hash/save it, and finally create this outer object. The prompt never contains this outer object, its hash, or fullPromptArtifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "requestCore", "requestCoreSha256", "fullPromptArtifact"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^D4-REQUEST-[A-Z0-9][A-Z0-9._-]*$" },
    "requestCore": { "$ref": "#/$defs/requestCore" },
    "requestCoreSha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of UTF-8 json.dumps(requestCore, ensure_ascii=False, sort_keys=True, separators=(',', ':'))."
    },
    "fullPromptArtifact": {
      "$ref": "#/$defs/artifactReference",
      "description": "Exact submitted provider payload bytes generated by auditPolicy.promptCompilation. It covers all role text and attachment descriptors explicitly sent by the orchestrator. Provider-internal implicit frames are not claimed here; when their identity is gate-relevant, the external authority must return a provider policy ID/digest."
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requestCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "laneRunId", "auditTrack", "mode", "candidate", "capsule", "auditPolicy",
        "runtimeAllowlist", "p0LifecycleTransition", "purpose", "writePolicy", "contextMode", "denyCategories",
        "requiredCheckIds"
      ],
      "properties": {
        "laneRunId": { "type": "string", "pattern": "^D4-RUN-[A-Z0-9][A-Z0-9._-]*$" },
        "auditTrack": { "enum": ["consistency", "roblox-readiness", "clean-room"] },
        "mode": {
          "enum": ["full", "delta"],
          "description": "Must equal capsule.auditScope.mode for all three lanes. D4-CAND is full only; P0-CAND may be delta/full. Mode never changes machine commands, complete candidate input coverage, B0/diff/dependency inputs, or pass criteria."
        },
        "candidate": { "$ref": "#/$defs/candidateReference" },
        "capsule": { "$ref": "#/$defs/artifactReference" },
        "auditPolicy": {
          "$ref": "#/$defs/policyReference",
          "description": "Must exactly equal capsule.auditPolicy after installed-skill reconstruction."
        },
        "runtimeAllowlist": {
          "$ref": "#/$defs/runtimeAllowlistReference",
          "description": "Must exactly equal capsule.runtimeAllowlist. Outside sanitizedRoot only the pinned Python/Git runtime and exact operator provenance verifier config/adapter closure may be read; policy scripts/imports execute from sanitizedRoot/_policy_runtime. No project config or PATH lookup."
        },
        "p0LifecycleTransition": {
          "oneOf": [
            { "$ref": "#/$defs/transitionProofReference" },
            { "type": "null" }
          ],
          "description": "Must exact-equal capsule.p0LifecycleTransition. Initial D4 is null; post-P0 requires the LTA/write-log/PV chain and includes it in requestCore/full prompt."
        },
        "purpose": { "const": "findings-only" },
        "writePolicy": { "const": "read-only" },
        "contextMode": { "const": "clean" },
        "denyCategories": {
          "const": [
            "conversation-history",
            "worker-identity",
            "prior-findings",
            "expected-verdict",
            "e0-capability-probe",
            "handoff-conversation",
            "self-evaluation"
          ]
        },
        "requiredCheckIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]*$" },
          "description": "Must equal the installed policy's command IDs applicable to this lane and candidate kind, and exact-cover capsule.requiredAuditCommands."
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "policyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "compiledPolicySha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^D4-POLICY-[A-Z0-9][A-Z0-9._-]*$" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "compiledPolicySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtimeAllowlistReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "digestSha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "digestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "candidateReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "fileSetSha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^(?:D4|P0)-CAND-[A-Z0-9][A-Z0-9._-]*$" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "fileSetSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "transitionProofReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation", "writeLog", "provenanceVerification"],
      "properties": {
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "path", "sha256"],
          "properties": {
            "id": { "type": "string", "pattern": "^LTA-P0-[A-Z0-9][A-Z0-9._-]*$" },
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "writeLog": { "$ref": "#/$defs/artifactReference" },
        "provenanceVerification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "path", "sha256"],
          "properties": {
            "id": { "type": "string", "pattern": "^PV-P0-TRANSITION-[A-Z0-9][A-Z0-9._-]*$" },
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requestCore": {
            "properties": {
              "candidate": {
                "properties": { "id": { "pattern": "^D4-CAND-" } },
                "required": ["id"]
              }
            },
            "required": ["candidate"]
          }
        },
        "required": ["requestCore"]
      },
      "then": {
        "properties": {
          "requestCore": { "properties": { "mode": { "const": "full" }, "p0LifecycleTransition": { "type": "null" } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requestCore": {
            "properties": {
              "candidate": {
                "properties": { "id": { "pattern": "^P0-CAND-" } },
                "required": ["id"]
              }
            },
            "required": ["candidate"]
          }
        },
        "required": ["requestCore"]
      },
      "then": {
        "properties": {
          "requestCore": { "properties": { "p0LifecycleTransition": { "$ref": "#/$defs/transitionProofReference" } } }
        }
      }
    }
  ]
}
