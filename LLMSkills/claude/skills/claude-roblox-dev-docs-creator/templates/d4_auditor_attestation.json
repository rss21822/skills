{
  "schemaVersion": "1.0.0",
  "id": "D4-ATTEST-{{PREFIX}}-{{TRACK}}-{{CANDIDATE_ID}}-R{{ROUND}}",
  "laneRunId": "D4-RUN-{{PREFIX}}-{{TRACK}}-{{CANDIDATE_ID}}-R{{ROUND}}",
  "executionId": "{{RUNTIME_EXECUTION_ID}}",
  "sessionId": "{{RUNTIME_SESSION_ID}}",
  "auditTrack": "{{TRACK}}",
  "auditorClass": "A",
  "worker": "{{WORKER}}",
  "requestedModel": "{{REQUESTED_MODEL}}",
  "resolvedModel": "{{RESOLVED_MODEL}}",
  "toolVersion": "{{TOOL_VERSION}}",
  "contextMode": "clean",
  "filesystemAccess": "read-only-sanitized-root-plus-pinned-runtime-and-verifier",
  "capsule": {
    "path": "{{CAPSULE_PATH}}",
    "sha256": "{{CAPSULE_SHA256}}"
  },
  "auditPolicy": {
    "id": "{{D4_AUDIT_POLICY_ID}}",
    "path": "{{D4_AUDIT_POLICY_PATH}}",
    "sha256": "{{D4_AUDIT_POLICY_SHA256}}",
    "compiledPolicySha256": "{{D4_COMPILED_POLICY_SHA256}}"
  },
  "runtimeAllowlist": {
    "path": "{{D4_RUNTIME_ALLOWLIST_PATH}}",
    "sha256": "{{D4_RUNTIME_ALLOWLIST_SHA256}}",
    "digestSha256": "{{D4_RUNTIME_ALLOWLIST_DIGEST_SHA256}}"
  },
  "fullPromptArtifact": {
    "path": "{{FULL_PROVIDER_PROMPT_PATH}}",
    "sha256": "{{FULL_PROVIDER_PROMPT_SHA256}}"
  },
  "requestCoreSha256": "{{CANONICAL_REQUEST_CORE_SHA256}}",
  "inspectedInputs": [
    {
      "path": "{{INSPECTED_CAPSULE_PATH}}",
      "sha256": "{{INSPECTED_INPUT_SHA256}}"
    }
  ],
  "commands": [
    {
      "checkId": "{{EXACT_REQUIRED_CHECK_ID}}",
      "argv": ["{{EXACT_ARGV_ITEM}}"],
      "cwd": "{{PROJECT_RELATIVE_CWD}}",
      "exitCode": 0,
      "outputPath": "{{COMMAND_OUTPUT_PATH}}",
      "outputSha256": "{{COMMAND_OUTPUT_SHA256}}"
    }
  ],
  "requestArtifact": {
    "path": "{{REQUEST_ARTIFACT_PATH}}",
    "sha256": "{{REQUEST_ARTIFACT_SHA256}}"
  },
  "responseArtifact": {
    "path": "{{RESPONSE_ARTIFACT_PATH}}",
    "sha256": "{{RESPONSE_ARTIFACT_SHA256}}"
  },
  "finishReason": "stop",
  "startedAt": "{{STARTED_AT_WITH_TIMEZONE}}",
  "completedAt": "{{COMPLETED_AT_WITH_TIMEZONE}}"
}
