{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analytics Event Definition",
  "type": "object",
  "required": [
    "id",
    "name",
    "source",
    "trigger",
    "fields",
    "kpis",
    "test"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^AN-[A-Z0-9]+-[0-9]{3}$"
    },
    "name": {
      "type": "string"
    },
    "source": {
      "enum": [
        "server",
        "client",
        "external"
      ]
    },
    "trigger": {
      "type": "string"
    },
    "fields": {
      "type": "object"
    },
    "sampling": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "expected_volume_per_dau": {
      "type": "number",
      "minimum": 0
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "privacy_notes": {
      "type": "string"
    },
    "test": {
      "type": "string"
    }
  }
}
