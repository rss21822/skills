{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-ai-development-os/w0-runtime-prepare-execution-attestation.schema.json",
  "title": "W0 Runtime PREPARE Execution Attestation",
  "description": "Operator-external signed actual-process proof for bootstrap PREPARE. Authority monitoring/enforcement starts before process creation and observes the loaded PowerShell/bootstrap/runtime closure, exact invocation/input identities, permitted writes, challenge/temp result, chronology, and exit. Raw direct PowerShell PREPARE or local self-report is invalid. Signed bytes use required-list property order, minified UTF-8, no BOM/newline/duplicate/whitespace; installed template is authoring input only and its terminal LF is not emitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "kind", "id", "runId", "receiverNonce", "authoritySessionId", "monitorSessionId",
    "operatorExpectedConfigSha256", "configSha256", "packageSha256", "projectInputTreeSha256", "installedSkillTreeSha256",
    "hostExecutableSha256", "bootstrapScriptSha256", "hostRuntimeClosureSha256",
    "argvSha256", "cwdSha256", "envSha256", "inputIdentitySetSha256", "loadedClosureSha256",
    "loadedClosureMatchesConfig", "monitorStartedBeforeProcess", "enforcementContinuous",
    "writePolicy", "resolvedTempRoot", "tempRootIdentity", "resolvedLaunchChallengePath", "resolvedAuthorizationEvidenceRoot", "authorizationEvidenceRootIdentity",
    "launchChallengeSha256", "challengeFileIdentity", "projectPackageSkillWriteCount",
    "pythonStarted", "startedAt", "completedAt", "attestedAt", "exitCode"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "w0-runtime-prepare-execution-v1" },
    "id": { "type": "string", "pattern": "^W0-RUNTIME-PREPARE-[A-Z0-9][A-Z0-9._-]*$" },
    "runId": { "type": "string", "minLength": 16 },
    "receiverNonce": { "type": "string", "minLength": 32 },
    "authoritySessionId": { "type": "string", "minLength": 16 },
    "monitorSessionId": { "type": "string", "minLength": 16 },
    "operatorExpectedConfigSha256": { "$ref": "#/$defs/sha256", "description": "Authority-observed out-of-band CLI scalar; exact-matches challenge, actual config hash, pre/post, and admission." },
    "configSha256": { "$ref": "#/$defs/sha256", "description": "Authority-observed raw ConfigPath hash, equal to operatorExpectedConfigSha256 before parsing." },
    "packageSha256": { "$ref": "#/$defs/sha256" },
    "projectInputTreeSha256": { "$ref": "#/$defs/sha256" },
    "installedSkillTreeSha256": { "$ref": "#/$defs/sha256" },
    "hostExecutableSha256": { "$ref": "#/$defs/sha256" },
    "bootstrapScriptSha256": { "$ref": "#/$defs/sha256" },
    "hostRuntimeClosureSha256": { "$ref": "#/$defs/sha256" },
    "argvSha256": { "$ref": "#/$defs/sha256", "description": "SHA-256 of the canonical PREPARE protocol vector [pinned hostExecutable,*hostFixedArgs,pinned bootstrap script,*fixed ordered phase tail], with all path operands identity-resolved to uppercase-drive forward-slash form and UTF-8 elements joined by one NUL. Environment.GetCommandLineArgs/pwsh.dll and raw slash/case spelling are not hash inputs; the external authority separately attests that the actual OS invocation resolves to this vector." },
    "cwdSha256": { "$ref": "#/$defs/sha256" },
    "envSha256": { "$ref": "#/$defs/sha256" },
    "inputIdentitySetSha256": { "$ref": "#/$defs/sha256" },
    "loadedClosureSha256": { "$ref": "#/$defs/sha256" },
    "loadedClosureMatchesConfig": { "const": true },
    "monitorStartedBeforeProcess": { "const": true },
    "enforcementContinuous": { "const": true },
    "writePolicy": { "const": "only-predeclared-fresh-temp-and-external-challenge-v1" },
    "resolvedTempRoot": { "$ref": "#/$defs/absolutePath" },
    "tempRootIdentity": { "type": "string", "minLength": 1 },
    "resolvedLaunchChallengePath": { "$ref": "#/$defs/absolutePath" },
    "resolvedAuthorizationEvidenceRoot": { "$ref": "#/$defs/absolutePath" },
    "authorizationEvidenceRootIdentity": { "type": "string", "minLength": 1 },
    "launchChallengeSha256": { "$ref": "#/$defs/sha256" },
    "challengeFileIdentity": { "type": "string", "minLength": 1 },
    "projectPackageSkillWriteCount": { "const": 0 },
    "pythonStarted": { "const": false },
    "startedAt": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,7})?(?:Z|[+-](?:(?:0\\d|1[0-3]):[0-5]\\d|14:00))$" },
    "completedAt": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,7})?(?:Z|[+-](?:(?:0\\d|1[0-3]):[0-5]\\d|14:00))$" },
    "attestedAt": { "type": "string", "format": "date-time", "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,7})?(?:Z|[+-](?:(?:0\\d|1[0-3]):[0-5]\\d|14:00))$" },
    "exitCode": { "const": 0 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "absolutePath": { "type": "string", "pattern": "^[A-Za-z]:[\\\\/].+", "description": "Windows local-drive absolute path for W0 lifecycle v1. POSIX, UNC, device, ADS, and relative paths are invalid." }
  }
}
