{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-ai-development-os/commerce-ledger.schema.json",
  "title": "Commerce Product and Entitlement Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "prefix", "products"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "project": { "type": "string", "minLength": 1 },
    "prefix": { "type": "string", "pattern": "^[A-Z0-9]{2,6}$" },
    "products": { "type": "array", "items": { "$ref": "#/$defs/product" } }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "kind", "environment", "robloxProductId", "entitlement",
        "grantMode", "receiptIdempotency", "refundOrRevocation", "owner",
        "evidence", "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^COM-[A-Z0-9]+-[0-9]{3}$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["game_pass", "developer_product", "subscription", "paid_access"] },
        "environment": { "enum": ["dev", "staging", "production"] },
        "robloxProductId": { "type": ["integer", "null"], "minimum": 1 },
        "entitlement": { "type": "string", "minLength": 1 },
        "grantMode": { "enum": ["durable", "consumable", "time_limited"] },
        "receiptIdempotency": { "type": "string", "minLength": 1 },
        "refundOrRevocation": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "status": { "enum": ["proposed", "approved", "disabled", "superseded"] }
      }
    }
  }
}
