    "inspectedInputsSha256": "{{CANONICAL_INSPECTED_INPUTS_SHA256}}",
    "requestId": "{{D4_REQUEST_ID}}",
    "requestCoreSha256": "{{CANONICAL_REQUEST_CORE_SHA256}}",
    "requestSha256": "{{D4_REQUEST_SHA256}}",
