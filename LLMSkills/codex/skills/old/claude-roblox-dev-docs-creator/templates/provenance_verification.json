    "path": "{{PINNED_SIGNATURE_EVIDENCE_PATH}}",
    "sha256": "{{PINNED_SIGNATURE_EVIDENCE_SHA256}}"
  },
  "verificationContext": {
    "kind": "pinned-signature-v1",
    "algorithm": "rsa-pss-sha256",
