        "project_slug": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "full",
            "research-only",
            "audit",
            "refine"
          ]
        },
        "depth": {
          "type": "string",
          "enum": [
            "standard",
            "deep"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "partial",
            "complete"
          ]
